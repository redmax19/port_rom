From 97fee2a1f6d860a9c46596f566e065bb177e4d2c Mon Sep 17 00:00:00 2001
From: Android-Artisan <romartisan2025@gmail.com>
Date: Thu, 30 Jul 2026 05:40:15 +0200
Subject: [PATCH] Fix FOD brightness scaling in getAlphaMaskLevel

---
 SemDisplaySolutionManagerService.smali | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/smali_classes2/com/samsung/android/displaysolution/SemDisplaySolutionManagerService.smali b/smali_classes2/com/samsung/android/displaysolution/SemDisplaySolutionManagerService.smali
index 4ac3a73..883a000 100644
--- a/smali_classes2/com/samsung/android/displaysolution/SemDisplaySolutionManagerService.smali
+++ b/smali_classes2/com/samsung/android/displaysolution/SemDisplaySolutionManagerService.smali
@@ -7330,6 +7330,24 @@
 .method public final getAlphaMaskLevel(FFF)F
     .locals 7
 
+    const/4 v5, 0x0
+
+    cmpl-float v5, p1, v5
+
+    if-ltz v5, :fod_scale_end
+
+    const/high16 v5, 0x3f800000    # 1.0f
+
+    cmpg-float v5, p1, v5
+
+    if-gtz v5, :fod_scale_end
+
+    const/high16 v5, 0x437f0000    # 255.0f
+
+    mul-float/2addr p1, v5
+
+    :fod_scale_end
+
     .line 1
     new-instance v0, Ljava/lang/StringBuilder;
 
-- 
2.53.0

